# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Clé publique ("Publishable key", commence par sb_publishable_) — sûre côté navigateur
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# Clé secrète ("Secret key", commence par sb_secret_) — bypass RLS, jamais exposée au client
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# Resend (resend.com/api-keys)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL="VGS Autos <reservation@vgs-autos.fr>"

# Emails internes qui reçoivent la notif "nouvelle plaque à planifier"
NOTIFY_ADMIN_EMAIL=robin@vgs-autos.fr

# Secret partagé pour sécuriser l'appel du cron Vercel
CRON_SECRET=change-me-to-a-long-random-string

# URL publique de l'app (utilisée dans les liens des emails)
NEXT_PUBLIC_APP_URL=https://votre-app.vercel.app
